# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files (secrets)
.env
backend/.env
# ...including timestamped backups. backend/.env.bak-* held a live
# SESSION_SECRET and GOOGLE_CLIENT_SECRET while matching no rule above.
.env.*
!.env.example
backend/.env.*
!backend/.env.example

# Backend (Python)
backend/.venv
backend/__pycache__
backend/**/__pycache__
backend/.pytest_cache

# scripts/fetch-learning-content.js resumable fetch cache (raw file content —
# large, and regenerable by re-running `npm run fetch-content`)
.fetch-cache

# scripts/merge-assessments.js writes a timestamped copy of
# learning-content.json before each run — ~3 MB each and regenerable.
src/data/learning-content.backup-*.json
